# Server-only credentials required for the real v0.2 smoke test.
# The official default is https://api.sb.createos.sh. Use a regional endpoint
# only after confirming that it was issued for your account.
CREATEOS_SANDBOX_BASE_URL=
CREATEOS_SANDBOX_API_KEY=
# Optional: an exact shape ID from client.listShapes(). Leave blank for discovery.
CREATEOS_SANDBOX_SHAPE=

# v0.3: one server-only Gemini provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server-only public origin, required for browser POSTs in production.
# Railway: https://aegis-sre-production.up.railway.app
# ALLOWED_ORIGIN is an alternative (or an additional exact origin).
# Localhost is allowed automatically only with NODE_ENV=development.
APP_ORIGIN=
ALLOWED_ORIGIN=
